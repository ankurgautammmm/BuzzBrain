    {
      "parameters": {
        "jsCode": "const id = $('Identify Parent').first().json;\nconst s = id.student;\nconst real = a => a.map(i => i.json).filter(r => r && Object.keys(r).length);\nconst att = real($('Get Attendance').all());\nconst tests = real($('Get Tests').all());\nconst rem = real($('Get Remarks').all());\nconst todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });\nconst today = new Date(todayStr);\nconst d = v => new Date(String(v).trim());\n\n// attendance\nconst attSorted = att.filter(r => r.Date).sort((a, b) => d(a.Date) - d(b.Date));\nconst isP = r => String(r.Status).trim().toUpperCase().startsWith('P');\nconst total = attSorted.length;\nconst present = attSorted.filter(isP).length;\nconst last30 = attSorted.filter(r => (today - d(r.Date)) / 86400000 <= 30);\nconst present30 = last30.filter(isP).length;\nconst recentAbsents = attSorted.filter(r => !isP(r)).slice(-5).map(r => String(r.Date));\nlet streak = 0;\nfor (let i = attSorted.length - 1; i >= 0; i--) { if (isP(attSorted[i])) break; streak++; }\n\n// tests\nconst pct = r => Number(r.Max_Marks) > 0 ? (Number(r.Marks) / Number(r.Max_Marks)) * 100 : null;\nconst tt = tests.map(r => ({ ...r, p: pct(r) })).filter(r => r.p !== null && !isNaN(r.p)).sort((a, b) => d(a.Date) - d(b.Date));\nconst bySub = {};\nfor (const r of tt) { (bySub[r.Subject] = bySub[r.Subject] || []).push(r); }\nconst subjects = Object.entries(bySub).map(([sub, arr]) => {\n  const avg = arr.reduce((x, r) => x + r.p, 0) / arr.length;\n  const last = arr[arr.length - 1];\n  const prev = arr.length > 1 ? arr[arr.length - 2] : null;\n  const earlier = arr.slice(0, -1);\n  const earlierAvg = earlier.length ? earlier.reduce((x, r) => x + r.p, 0) / earlier.length : null;\n  let trend = 'not enough data yet';\n  if (earlierAvg !== null) { const diff = last.p - earlierAvg; trend = diff > 5 ? 'improving' : diff < -5 ? 'declining' : 'stable'; }\n  return { subject: sub, tests_taken: arr.length, average_percent: Math.round(avg), last_test: last.Test_Name || '',\n           last_date: String(last.Date), last_marks: last.Marks + '/' + last.Max_Marks,\n           change_vs_previous_test_percent_points: prev ? Math.round(last.p - prev.p) : null,\n           trend_vs_earlier_tests: trend };\n});\nconst sortedSub = [...subjects].sort((a, b) => a.average_percent - b.average_percent);\n\n// fees\nconst due = Math.max(0, Number(s.Fee_Total || 0) - Number(s.Fee_Paid || 0));\n\nrem.sort((a, b) => d(a.Date) - d(b.Date));\nconst facts = {\n  student: { name: s.Name, batch: s.Batch },\n  as_of: todayStr,\n  attendance: total ? {\n    overall_percent: Math.round(present / total * 100), days_recorded: total, days_present: present, days_absent: total - present,\n    last_30_days_percent: last30.length ? Math.round(present30 / last30.length * 100) : null,\n    recent_absent_dates: recentAbsents, current_consecutive_absent_days: streak\n  } : 'no attendance recorded yet',\n  tests: subjects.length ? {\n    subjects,\n    weakest_subject: subjects.length > 1 ? sortedSub[0].subject : null,\n    strongest_subject: subjects.length > 1 ? sortedSub[sortedSub.length - 1].subject : null\n  } : 'no test results recorded yet',\n  teacher_remarks: rem.slice(-5).map(r => ({ date: String(r.Date), type: r.Type || '', remark: r.Remark })),\n  fees: { total: Number(s.Fee_Total || 0), paid: Number(s.Fee_Paid || 0), due: due, due_date: s.Fee_Due_Date || '' }\n};\nreturn [{ json: { facts: JSON.stringify(facts), question: id.text } }];"
      },
      "name": "Build Facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
