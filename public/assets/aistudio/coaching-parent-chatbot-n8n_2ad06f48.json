    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const m = (item.json.messages || [])[0];\n  if (!m || m.type === 'reaction') continue;\n  const name = ((item.json.contacts || [])[0] || {}).profile?.name || '';\n  const isText = m.type === 'text';\n  out.push({ json: { from: m.from, name, text: isText ? String(m.text.body || '').trim() : '', nonText: !isText } });\n}\nreturn out;"
      },
