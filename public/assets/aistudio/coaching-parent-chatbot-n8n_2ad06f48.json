    {
      "parameters": {
        "jsCode": "const m = $('Parse Message').first().json;\nconst students = $('Get Students').all().map(i => i.json).filter(r => r && r.Student_ID);\nconst blockedRows = $('Get Blocked').all().map(i => i.json).filter(r => r && r.Phone);\nconst last10 = v => String(v || '').replace(/\\D/g, '').slice(-10);\nconst p10 = last10(m.from);\nconst base = { from: m.from, name: m.name, text: m.text, student: null, students: [], idGuess: '', attempts: 0, blockedUntil: '' };\n\nconst b = blockedRows.find(r => last10(r.Phone) === p10);\nlet prevAttempts = b ? Number(b.Wrong_Attempts || 0) : 0;\nif (b && b.Blocked_Until) {\n  if (Date.parse(b.Blocked_Until) > Date.now()) return [{ json: { ...base, status: 'blocked' } }];\n  prevAttempts = 0; // block expired, start fresh\n}\n\nconst matches = students.filter(s => String(s.Active || '').trim().toLowerCase() !== 'no' &&\n  (last10(s.Parent_Phone_1) === p10 || last10(s.Parent_Phone_2) === p10));\n\nconst idMatch = (m.text || '').match(/\\b[A-Za-z]{2,5}-[A-Za-z0-9]{5,8}\\b/);\nif (matches.length === 0) {\n  const attempts = prevAttempts + 1;\n  return [{ json: { ...base, status: 'unknown', idGuess: idMatch ? idMatch[0].toUpperCase() : '', attempts,\n    blockedUntil: attempts >= 3 ? new Date(Date.now() + 3600000).toISOString() : '' } }];\n}\nif (m.nonText) return [{ json: { ...base, status: 'nontext' } }];\n\nconst text = (m.text || '').toLowerCase();\nlet chosen = null;\nif (matches.length === 1) {\n  chosen = matches[0];\n} else {\n  const named = matches.filter(s => { const f = String(s.Name || '').trim().split(' ')[0].toLowerCase(); return f && text.includes(f); });\n  if (named.length === 1) chosen = named[0];\n}\nif (!chosen) return [{ json: { ...base, status: 'ask_which', students: matches.map(s => s.Name) } }];\n\nconst words = ['refund', 'complaint', 'complain', 'shikayat', 'शिकायत', 'legal', 'police', 'harass', 'fees wapas', 'paise wapas'];\nconst escalate = words.some(w => text.includes(w));\nreturn [{ json: { ...base, status: escalate ? 'escalate' : 'ok', student: chosen } }];"
      },
